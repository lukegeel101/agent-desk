# Copy to desk.env and edit. Every setting is optional; environment variables win over this file.

# Where the agent works: its current directory for every run. Defaults to your home folder.
# DESK_WORKDIR=~/code

# Default model for new messages: opus, sonnet or haiku. The page's picker overrides it.
# DESK_MODEL=sonnet

# How runs may act without asking (nobody is at a terminal to approve prompts):
#   acceptEdits        file edits allowed; other tools need an allow rule in your Claude Code settings (default)
#   auto               a classifier approves safe actions and blocks risky ones (needs a plan that supports it)
#   bypassPermissions  everything allowed; only on a machine and account you are happy to hand over completely
# DESK_PERMISSION_MODE=acceptEdits

# Runs at once (each conversation answers one message at a time), and the time limit per run in minutes.
# DESK_MAX_PARALLEL=3
# DESK_TIMEOUT_MIN=60

# Reasoning effort passed to claude --effort (low, medium, high, xhigh, max). Empty uses the CLI default.
# DESK_EFFORT=medium

# Replace the built-in instructions appended to Claude Code's system prompt.
# DESK_SYSTEM_PROMPT_FILE=~/agent-desk-prompt.md

# Extra flags for every run, for example --chrome to let it use Claude in Chrome, or --add-dir ~/notes.
# DESK_EXTRA_ARGS=--chrome

# Name a short conversation title with a quick Haiku call after the first reply (1) or keep the first words (0).
# DESK_AUTO_TITLE=1

# Network. The default only accepts this computer. To reach it from your phone, listen on a private network
# address (for example your Tailscale IP) AND set a long random token; it refuses to start otherwise.
# DESK_HOST=127.0.0.1
# DESK_PORT=4280
# DESK_TOKEN=

# Where conversations and run logs are kept, and which claude binary to run.
# DESK_DATA=./data
# DESK_CLAUDE=claude
